from "./catalog.yl" import fetch_surahs, fetch_reciters, surah_count, surah_name, reciter_count, reciter_name, reciter_audio_url;
from "./storage.yl" import storage_read, storage_add_favorite, storage_add_history, storage_add_playlist;
from "./player.yl" import player_play_remote, player_play_local, player_download;
from "./ui.yl" import ui_draw_main, ui_prompt, ui_wait;

function choose_surah(string document, int current) -> int {
    let int count = surah_count(document);
    if (count <= 0) {
        return current;
    }
    let int selected = current - 1;
    if (selected < 0) {
        selected = 0;
    }
    if (selected >= count) {
        selected = count - 1;
    }
    let bool done = false;

    while (!done) {
        tui.clear();
        tui.write("Browse Surahs — Up/Down, Enter select, Esc cancel\n\n");
        let int start = selected - 4;
        if (start < 0) {
            start = 0;
        }
        let int end = start + 9;
        if (end > count) {
            end = count;
        }
        let int index = start;
        while (index < end) {
            if (index == selected) {
                tui.write("> ");
            }
            else {
                tui.write("  ");
            }
            tui.write(to_string(index + 1));
            tui.write("  ");
            tui.write(surah_name(document, index));
            tui.write("\n");
            index = index + 1;
        }

        let int key = tui.poll_key();
        if (key == 1001 and selected > 0) {
            selected = selected - 1;
        }
        else if (key == 1002 and selected + 1 < count) {
            selected = selected + 1;
        }
        else if (key == 13) {
            done = true;
        }
        else if (key == 27) {
            return current;
        }
        tui.sleep_ms(20);
    }
    return selected + 1;
}

function choose_reciter(string document, int current) -> int {
    let int count = reciter_count(document);
    if (count <= 0) {
        return current;
    }
    let int selected = current;
    if (selected < 0) {
        selected = 0;
    }
    if (selected >= count) {
        selected = count - 1;
    }
    let bool done = false;

    while (!done) {
        tui.clear();
        tui.write("Choose Reader — Up/Down, Enter select, Esc cancel\n\n");
        let int start = selected - 4;
        if (start < 0) {
            start = 0;
        }
        let int end = start + 9;
        if (end > count) {
            end = count;
        }
        let int index = start;
        while (index < end) {
            if (index == selected) {
                tui.write("> ");
            }
            else {
                tui.write("  ");
            }
            tui.write(to_string(index + 1));
            tui.write("  ");
            tui.write(reciter_name(document, index));
            tui.write("\n");
            index = index + 1;
        }

        let int key = tui.poll_key();
        if (key == 1001 and selected > 0) {
            selected = selected - 1;
        }
        else if (key == 1002 and selected + 1 < count) {
            selected = selected + 1;
        }
        else if (key == 13) {
            done = true;
        }
        else if (key == 27) {
            return current;
        }
        tui.sleep_ms(20);
    }
    return selected;
}

function find_surah(string document, string query) -> int {
    let owned_string needle = string.lower(query);
    let int count = surah_count(document);
    let int index = 0;
    while (index < count) {
        let owned_string name = string.lower(surah_name(document, index));
        if (string.contains(name, needle)) {
            return index + 1;
        }
        index = index + 1;
    }
    return 0;
}

function find_reciter(string document, string query) -> int {
    let owned_string needle = string.lower(query);
    let int count = reciter_count(document);
    let int index = 0;
    while (index < count) {
        let owned_string name = string.lower(reciter_name(document, index));
        if (string.contains(name, needle)) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

function start_current(string reciters, int surah_id, int reciter_index, int volume) -> bool {
    let owned_string url = reciter_audio_url(reciters, reciter_index, surah_id);
    if (string.length(url) == 0) {
        return false;
    }
    if (!player_play_remote(url, volume)) {
        return false;
    }
    storage_add_history(surah_id, reciter_name(reciters, reciter_index));
    return true;
}

function download_current(string reciters, int surah_id, int reciter_index) -> int {
    let owned_string url = reciter_audio_url(reciters, reciter_index, surah_id);
    if (string.length(url) == 0) {
        return -1;
    }
    let owned_string number = to_string(surah_id);
    if (surah_id < 10) {
        number = string.concat("00", number);
    }
    else if (surah_id < 100) {
        number = string.concat("0", number);
    }
    let owned_string filename = string.concat("ytilawa-", number);
    filename = string.concat(filename, ".mp3");
    return player_download(url, filename);
}

function show_saved(string title, string path) -> int {
    let owned_string contents = storage_read(path);
    tui.clear();
    tui.write(title);
    tui.write("\n------------------------------\n");
    if (string.length(contents) == 0) {
        tui.write("No entries yet.\n");
    }
    else {
        tui.write(contents);
    }
    ui_wait("Return");
    return 0;
}

function ytilawa_main() -> int {
    print("YTilawa Extended — loading MP3Quran.net catalog...");
    let owned_string surahs = fetch_surahs();
    let owned_string reciters = fetch_reciters();
    if (!json.valid(surahs) or !json.valid(reciters)) {
        print("Could not load the live Quran catalog.");
        print(http.last_error());
        return 1;
    }

    let int total_surahs = surah_count(surahs);
    let int total_reciters = reciter_count(reciters);
    if (total_surahs != 114 or total_reciters <= 0) {
        print("The catalog response is incomplete or has an unexpected shape.");
        return 1;
    }

    if (!tui.init()) {
        print(tui.last_error());
        return 1;
    }
    voice.init();
    let int current_surah = 1;
    let int current_reciter = 0;
    let int volume = 80;
    let bool playing = false;
    let bool paused = false;
    let bool running = true;
    let owned_string message = "Ready. Catalog: MP3Quran.net.";

    while (running) {
        if (playing and voice.is_finished()) {
            playing = false;
            paused = false;
            message = "Playback finished.";
        }

        ui_draw_main(
            surah_name(surahs, current_surah - 1),
            reciter_name(reciters, current_reciter),
            current_surah, volume, playing, paused, message
        );

        let int key = tui.poll_key();
        if (key == 113 or key == 81) {
            running = false;
        } else if (key == 98 or key == 66) {
            let int previous_surah = current_surah;
            current_surah = choose_surah(surahs, current_surah);
            if (current_surah != previous_surah) {
                voice.stop();
                playing = false;
                paused = false;
            }
            message = "Surah selected.";
        } else if (key == 114 or key == 82) {
            let int previous_reciter = current_reciter;
            current_reciter = choose_reciter(reciters, current_reciter);
            if (current_reciter != previous_reciter) {
                voice.stop();
                playing = false;
                paused = false;
            }
            message = "Reader selected.";
        } else if (key == 47) {
            let owned_string query = ui_prompt("Search surah: ");
            let int found = find_surah(surahs, query);
            if (found > 0) {
                current_surah = found;
                voice.stop();
                playing = false;
                paused = false;
                message = "Search result selected.";
            } else {
                message = "No matching surah was found.";
            }
        } else if (key == 103 or key == 71) {
            let owned_string query = ui_prompt("Search reader: ");
            let int found = find_reciter(reciters, query);
            if (found >= 0) {
                current_reciter = found;
                voice.stop();
                playing = false;
                paused = false;
                message = "Reader search result selected.";
            } else {
                message = "No matching reader was found.";
            }
        } else if (key == 32) {
            if (voice.is_paused()) {
                voice.resume();
                paused = false;
                playing = true;
                message = "Resumed.";
            } else if (voice.is_playing()) {
                voice.pause();
                paused = true;
                message = "Paused.";
            } else if (start_current(reciters, current_surah, current_reciter, volume)) {
                playing = true;
                paused = false;
                message = "Playing online recitation.";
            } else {
                message = voice.last_error();
            }
        } else if (key == 110 or key == 78) {
            voice.stop();
            current_surah = current_surah + 1;
            if (current_surah > total_surahs) {
                current_surah = 1;
            }
            if (start_current(reciters, current_surah, current_reciter, volume)) {
                playing = true;
                paused = false;
                message = "Next surah.";
            } else {
                playing = false;
                message = voice.last_error();
            }
        } else if (key == 112 or key == 80) {
            voice.stop();
            current_surah = current_surah - 1;
            if (current_surah < 1) {
                current_surah = total_surahs;
            }
            if (start_current(reciters, current_surah, current_reciter, volume)) {
                playing = true;
                paused = false;
                message = "Previous surah.";
            } else {
                playing = false;
                message = voice.last_error();
            }
        } else if (key == 115 or key == 83) {
            voice.stop();
            playing = false;
            paused = false;
            message = "Stopped.";
        } else if (key == 102 or key == 70) {
            if (storage_add_favorite(current_surah)) {
                message = "Added to favorites.";
            }
            else {
                message = "Could not update favorites.";
            }
        } else if (key == 97 or key == 65) {
            if (storage_add_playlist(current_surah, reciter_name(reciters, current_reciter)))
                message = "Added to the default playlist.";
            else {
                message = "Could not update playlist.";
            }
        } else if (key == 104 or key == 72) {
            show_saved("Listening history", "ytilawa-history.txt");
        } else if (key == 118 or key == 86) {
            show_saved("Favorites", "ytilawa-favorites.txt");
        } else if (key == 99 or key == 67) {
            show_saved("Default playlist", "ytilawa-playlist-default.txt");
        } else if (key == 100 or key == 68) {
            let int bytes = download_current(reciters, current_surah, current_reciter);
            if (bytes >= 0) {
                message = string.concat("Downloaded bytes: ", to_string(bytes));
            } else {
                message = "Download failed. Check the network and reader availability.";
            }
        } else if (key == 108 or key == 76) {
            let owned_string path = ui_prompt("Local MP3 path: ");
            if (player_play_local(path, volume)) {
                playing = true;
                paused = false;
                message = "Playing local file.";
            } else {
                message = voice.last_error();
            }
        } else if (key == 43 or key == 61) {
            volume = volume + 5;
            if (volume > 100) {
                volume = 100;
            }
            voice.set_volume(volume);
            message = "Volume increased.";
        } else if (key == 45) {
            volume = volume - 5;
            if (volume < 0) {
                volume = 0;
            }
            voice.set_volume(volume);
            message = "Volume decreased.";
        }

        tui.sleep_ms(20);
    }

    voice.stop();
    voice.shutdown();
    tui.show_cursor();
    tui.shutdown();
    return 0;
}
