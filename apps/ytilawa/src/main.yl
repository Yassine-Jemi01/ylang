from "./catalog.yl" import fetch_surahs;
from "./catalog.yl" import fetch_reciters;
from "./catalog.yl" import surah_count;
from "./catalog.yl" import surah_name;
from "./catalog.yl" import reciter_count;
from "./catalog.yl" import reciter_name;
from "./catalog.yl" import reciter_audio_url;
from "./player.yl" import player_play_remote;
from "./player.yl" import player_pause;
from "./player.yl" import player_resume;
from "./player.yl" import player_stop;
from "./player.yl" import player_download;
from "./storage.yl" import storage_add_favorite;
from "./storage.yl" import storage_add_history;
from "./storage.yl" import storage_add_playlist;

function choose_surah(string document, int count, int initial) -> int {
    let int selected = initial;
    while (true) {
        tui.clear();
        tui.write("YTilawa Extended\n");
        tui.write("Choose a Surah  |  Up/Down or PgUp/PgDn  |  Enter: select  |  /: search  |  Q: quit\n\n");
        tui.write(f"Surah {selected + 1} / {count}\n");
        tui.write(surah_name(document, selected));
        tui.write("\n\n");
        tui.write("Available controls: arrows, page keys, Enter, /, q\n");
        let int key = tui.read_key();
        if (key == 1001) {
            selected = selected - 1;
            if (selected < 0) selected = count - 1;
        } else if (key == 1002) {
            selected = selected + 1;
            if (selected >= count) selected = 0;
        } else if (key == 1008) {
            selected = selected - 10;
            if (selected < 0) selected = 0;
        } else if (key == 1009) {
            selected = selected + 10;
            if (selected >= count) selected = count - 1;
        } else if (key == 13) {
            return selected;
        } else if (key == 47) {
            tui.shutdown();
            let string query = terminal.read_line("Search Surah name: ");
            if (string.length(query) > 0) {
                let int i = 0;
                while (i < count) {
                    if (string.contains(surah_name(document, i), query)) {
                        selected = i;
                        break;
                    }
                    i = i + 1;
                }
            }
            if (!tui.init()) return -1;
        } else if (key == 113 or key == 27) {
            return -1;
        }
    }
    return -1;
}

function choose_reciter(string document, int count) -> int {
    let int selected = 0;
    while (true) {
        tui.clear();
        tui.write("Choose a reciter\n");
        tui.write("Up/Down: move  |  Enter: select  |  Escape: back\n\n");
        tui.write(f"Reciter {selected + 1} / {count}\n");
        tui.write(reciter_name(document, selected));
        tui.write("\n");
        let int key = tui.read_key();
        if (key == 1001) {
            selected = selected - 1;
            if (selected < 0) selected = count - 1;
        } else if (key == 1002) {
            selected = selected + 1;
            if (selected >= count) selected = 0;
        } else if (key == 13) {
            return selected;
        } else if (key == 27) {
            return -1;
        }
    }
    return -1;
}

function playback_screen(int surah_id, string surah, string reciter, string url) -> int {
    let int volume = 80;
    if (!player_play_remote(url, volume)) {
        tui.clear();
        tui.write("Playback could not start\n");
        tui.write(voice.last_error());
        tui.write("\nPress any key to return.");
        tui.read_key();
        return 1;
    }

    storage_add_history(surah_id, reciter);
    storage_add_playlist(surah_id, reciter);
    while (voice.is_playing() or voice.is_paused()) {
        tui.clear();
        tui.write("YTilawa — Now Playing\n\n");
        tui.write("Surah: ");
        tui.write(surah);
        tui.write("\nReciter: ");
        tui.write(reciter);
        tui.write("\n\n");
        if (voice.is_paused()) tui.write("Status: Paused\n");
        else tui.write("Status: Playing\n");
        tui.write(f"Volume: {volume}%\n\n");
        tui.write("P: pause/resume   N: next   S: stop   F: favorite\n");
        tui.write("L: add to playlist   D: download   +/-: volume   Q: quit\n");
        let int key = tui.poll_key();
        if (key == 112) {
            if (voice.is_paused()) player_resume();
            else player_pause();
        } else if (key == 115) {
            player_stop();
            return 1;
        } else if (key == 110) {
            player_stop();
            return 1;
        } else if (key == 113 or key == 27) {
            player_stop();
            return 0;
        } else if (key == 102) {
            if (storage_add_favorite(surah_id)) tui.write("\nAdded to favorites.");
            tui.sleep_ms(250);
        } else if (key == 108) {
            if (storage_add_playlist(surah_id, reciter)) tui.write("\nAdded to playlist.");
            tui.sleep_ms(250);
        } else if (key == 100) {
            let string path = string.concat("surah-", to_string(surah_id));
            path = string.concat(path, ".mp3");
            let int bytes = player_download(url, path);
            tui.write("\n");
            if (bytes >= 0) tui.write(f"Downloaded {bytes} bytes to {path}");
            else tui.write("Download failed.");
            tui.sleep_ms(900);
        } else if (key == 43 and volume < 100) {
            volume = volume + 5;
            voice.set_volume(volume);
        } else if (key == 45 and volume > 0) {
            volume = volume - 5;
            voice.set_volume(volume);
        }
        tui.sleep_ms(40);
    }
    return 1;
}

function main() -> int {
    let owned_string surahs = fetch_surahs();
    let owned_string reciters = fetch_reciters();
    let int total_surahs = surah_count(surahs);
    let int total_reciters = reciter_count(reciters);
    if (total_surahs != 114 or total_reciters <= 0) {
        print("Could not load the Surah/reciter catalog from MP3Quran.net.");
        return 1;
    }
    if (!tui.init()) {
        print(tui.last_error());
        return 1;
    }

    let int current_surah = 0;
    let bool running = true;
    while (running) {
        let int surah_index = choose_surah(surahs, total_surahs, current_surah);
        if (surah_index < 0) {
            running = false;
        } else {
            current_surah = surah_index;
            let int reciter_index = choose_reciter(reciters, total_reciters);
            if (reciter_index >= 0) {
                let int surah_id = surah_index + 1;
                let owned_string surah = surah_name(surahs, surah_index);
                let owned_string reciter = reciter_name(reciters, reciter_index);
                let owned_string url = reciter_audio_url(reciters, reciter_index, surah_id);
                if (string.length(url) == 0) {
                    tui.clear();
                    tui.write("This reciter does not provide the selected Surah.\nPress any key.");
                    tui.read_key();
                } else if (playback_screen(surah_id, surah, reciter, url) == 0) {
                    running = false;
                }
            }
        }
    }
    player_stop();
    voice.shutdown();
    tui.clear();
    tui.show_cursor();
    tui.shutdown();
    return 0;
}
