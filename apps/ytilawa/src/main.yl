function choose_surah(borrowed_string document, int current) -> int {
    let int count = surah_count(document);
    if (count <= 0) {
        return current;
    }
    let int selected = current - 1;
    if (selected < 0) {
        selected = 0;
    }
    if (selected >= count) {
        selected = count - 1;
    }
    let int page_size = tui.height() - 8;
    if (page_size < 5) {
        page_size = 5;
    }
    if (page_size > 18) {
        page_size = 18;
    }
    let bool redraw = true;
    let string notice = "Use / to jump to a surah by name.";
    let bool done = false;

    while (!done) {
        if (redraw) {
            redraw = false;
            tui.clear();
        tui.write("\x1b[1;36m");
        tui.write("  SURAH LIBRARY\n");
        tui.write("\x1b[0;90m");
        tui.write("  Select a chapter from the Quran\n");
        tui.write("  ------------------------------------------------------------\n");
        tui.write("\x1b[0m");

        let int start = selected - (page_size / 2);
        if (start < 0) {
            start = 0;
        }
        let int max_start = count - page_size;
        if (max_start < 0) {
            max_start = 0;
        }
        if (start > max_start) {
            start = max_start;
        }
        let int end = start + page_size;
        if (end > count) {
            end = count;
        }
        let int index = start;
        while (index < end) {
            if (index == selected) {
                tui.write("\x1b[1;30;46m  > ");
            }
            else if (index % 2 == 0) {
                tui.write("\x1b[0;37m    ");
            }
            else {
                tui.write("\x1b[0;90m    ");
            }

            let int number = index + 1;
            if (number < 10) {
                tui.write("00");
            }
            else if (number < 100) {
                tui.write("0");
            }
            tui.write(to_string(number));
            tui.write("  |  ");
            let owned_string entry_name = surah_name(index);
            tui.write(entry_name);
            tui.write("\x1b[0m\n");
            index = index + 1;
        }

        tui.write("\n\x1b[0;90m  Showing ");
        tui.write(to_string(start + 1));
        tui.write("-");
        tui.write(to_string(end));
        tui.write(" of ");
        tui.write(to_string(count));
        tui.write("   |   Selected: ");
        tui.write(to_string(selected + 1));
        tui.write("\n  Up/Down Move  PgUp/PgDn Page  Home/End Jump  / Search  Enter Select  Esc Back\x1b[0m\n");
        tui.write("  ");
        tui.write(notice);
        tui.write("\n");
        }

        let int previous_selected = selected;
        let int key = tui.poll_key();
        if (key == 1001 and selected > 0) {
            selected = selected - 1;
        }
        else if (key == 1002 and selected + 1 < count) {
            selected = selected + 1;
        }
        else if (key == 1008) {
            selected = selected - page_size;
            if (selected < 0) {
                selected = 0;
            }
        }
        else if (key == 1009) {
            selected = selected + page_size;
            if (selected >= count) {
                selected = count - 1;
            }
        }
        else if (key == 1005) {
            selected = 0;
        }
        else if (key == 1006) {
            selected = count - 1;
        }
        else if (key == 47) {
            let owned_string query = ui_prompt("Find surah (Latin or Arabic): ");
            if (string.length(query) == 0) {
                notice = "Search cancelled.";
            }
            else {
                let owned_string needle = owned_string.lower(query);
                let int scan = 0;
                let bool found = false;
                while (scan < count and !found) {
                    let owned_string candidate = surah_name(scan);
                    let owned_string lowered = owned_string.lower(candidate);
                    if (string.contains(lowered, needle)) {
                        selected = scan;
                        found = true;
                    }
                    else {
                        let owned_string arabic = surah_arabic_name(document, scan);
                        if (string.contains(arabic, query)) {
                            selected = scan;
                            found = true;
                        }
                    }
                    scan = scan + 1;
                }
                if (found) {
                    notice = "Match found. Press Enter to confirm.";
                }
                else {
                    notice = "No matching surah was found.";
                }
            }
            redraw = true;
        }
        else if (key == 13) {
            done = true;
        }
        else if (key == 27) {
            return current;
        }
        if (selected != previous_selected) {
            redraw = true;
        }
        tui.sleep_ms(20);
    }
    return selected + 1;
}

function choose_reciter(borrowed_string document, int current) -> int {
    let int count = reciter_count(document);
    if (count <= 0) {
        return current;
    }
    let int selected = current;
    if (selected < 0) {
        selected = 0;
    }
    if (selected >= count) {
        selected = count - 1;
    }
    let int page_size = tui.height() - 8;
    if (page_size < 5) {
        page_size = 5;
    }
    if (page_size > 18) {
        page_size = 18;
    }
    let bool redraw = true;
    let string notice = "Use / to jump to a reader by name.";
    let bool done = false;

    while (!done) {
        if (redraw) {
            redraw = false;
            tui.clear();
        tui.write("\x1b[1;36m");
        tui.write("  RECITER DIRECTORY\n");
        tui.write("\x1b[0;90m");
        tui.write("  English names  /  MP3Quran.net catalogue\n");
        tui.write("  ------------------------------------------------------------\n");
        tui.write("\x1b[0m");

        let int start = selected - (page_size / 2);
        if (start < 0) {
            start = 0;
        }
        let int max_start = count - page_size;
        if (max_start < 0) {
            max_start = 0;
        }
        if (start > max_start) {
            start = max_start;
        }
        let int end = start + page_size;
        if (end > count) {
            end = count;
        }
        let int index = start;
        while (index < end) {
            if (index == selected) {
                tui.write("\x1b[1;30;46m  > ");
            }
            else if (index % 2 == 0) {
                tui.write("\x1b[0;37m    ");
            }
            else {
                tui.write("\x1b[0;90m    ");
            }

            let owned_string letter = reciter_letter(document, index);
            tui.write("\x1b[1;33m[");
            tui.write(letter);
            tui.write("]\x1b[0m");
            if (index == selected) {
                tui.write("\x1b[1;30;46m ");
            }
            else if (index % 2 == 0) {
                tui.write("\x1b[0;37m ");
            }
            else {
                tui.write("\x1b[0;90m ");
            }

            let int number = index + 1;
            if (number < 10) {
                tui.write("00");
            }
            else if (number < 100) {
                tui.write("0");
            }
            tui.write(to_string(number));
            tui.write("  |  ");
            let owned_string entry_name = reciter_name(document, index);
            tui.write(entry_name);
            tui.write("\x1b[0m\n");
            index = index + 1;
        }

        tui.write("\n\x1b[0;90m  Showing ");
        tui.write(to_string(start + 1));
        tui.write("-");
        tui.write(to_string(end));
        tui.write(" of ");
        tui.write(to_string(count));
        tui.write("   |   Selected: ");
        tui.write(to_string(selected + 1));
        tui.write("\n  Up/Down Move  PgUp/PgDn Page  Home/End Jump  Enter Select  Esc Back\x1b[0m\n");
        }

        let int previous_selected = selected;
        let int key = tui.poll_key();
        if (key == 1001 and selected > 0) {
            selected = selected - 1;
        }
        else if (key == 1002 and selected + 1 < count) {
            selected = selected + 1;
        }
        else if (key == 1008) {
            selected = selected - page_size;
            if (selected < 0) {
                selected = 0;
            }
        }
        else if (key == 1009) {
            selected = selected + page_size;
            if (selected >= count) {
                selected = count - 1;
            }
        }
        else if (key == 1005) {
            selected = 0;
        }
        else if (key == 1006) {
            selected = count - 1;
        }
        else if (key == 47) {
            let owned_string query = ui_prompt("Find reader (English name): ");
            if (string.length(query) == 0) {
                notice = "Search cancelled.";
            }
            else {
                let owned_string needle = owned_string.lower(query);
                let int scan = 0;
                let bool found = false;
                while (scan < count and !found) {
                    let owned_string candidate = reciter_name(document, scan);
                    let owned_string lowered = owned_string.lower(candidate);
                    if (string.contains(lowered, needle)) {
                        selected = scan;
                        found = true;
                    }
                    scan = scan + 1;
                }
                if (found) {
                    notice = "Match found. Press Enter to confirm.";
                }
                else {
                    notice = "No matching reader was found.";
                }
            }
            redraw = true;
        }
        else if (key == 13) {
            done = true;
        }
        else if (key == 27) {
            return current;
        }
        if (selected != previous_selected) {
            redraw = true;
        }
        tui.sleep_ms(20);
    }
    return selected;
}

function find_surah(borrowed_string document, borrowed_string query) -> int {
    let owned_string needle = owned_string.lower(query);
    let int count = surah_count(document);
    let int index = 0;
    while (index < count) {
        let owned_string candidate = surah_name(index);
        let owned_string name = owned_string.lower(candidate);
        if (string.contains(name, needle)) {
            return index + 1;
        }
        let owned_string arabic_name = surah_arabic_name(document, index);
        if (string.contains(arabic_name, query)) {
            return index + 1;
        }
        index = index + 1;
    }
    return 0;
}

function find_reciter(borrowed_string document, borrowed_string query) -> int {
    let owned_string needle = owned_string.lower(query);
    let int count = reciter_count(document);
    let int index = 0;
    while (index < count) {
        let owned_string candidate = reciter_name(document, index);
        let owned_string name = owned_string.lower(candidate);
        if (string.contains(name, needle)) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

function start_current(borrowed_string reciters, int surah_id, int reciter_index, int volume) -> bool {
    let owned_string url = reciter_audio_url(reciters, reciter_index, surah_id);
    if (string.length(url) == 0) {
        return false;
    }
    if (!player_play_remote(url, volume)) {
        return false;
    }
    let owned_string reader = reciter_name(reciters, reciter_index);
    storage_add_history(surah_id, reader);
    return true;
}

function download_current(borrowed_string reciters, int surah_id, int reciter_index) -> int {
    let owned_string url = reciter_audio_url(reciters, reciter_index, surah_id);
    if (string.length(url) == 0) {
        return -1;
    }
    let owned_string slug = surah_name(surah_id - 1);
    let owned_string filename = owned_string.concat("ytilawa-", slug);
    filename = owned_string.concat(filename, ".mp3");
    return player_download(url, filename);
}

function show_saved(string title, string path) -> int {
    let owned_string contents = storage_read(path);
    tui.clear();
    tui.write("\x1b[1;36m");
    tui.write(title);
    tui.write("\x1b[0;90m\n  ------------------------------------------------------------\n");
    tui.write("\x1b[0m");
    if (string.length(contents) == 0) {
        tui.write("No entries yet.\n");
    }
    else {
        tui.write(contents);
    }
    ui_wait("Return");
    return 0;
}

function ytilawa_main() -> int {
    print("YTilawa Extended — loading MP3Quran.net catalogue...");
    let owned_string surahs = fetch_surahs();
    let owned_string reciters = fetch_reciters();
    if (!json.valid(surahs) or !json.valid(reciters)) {
        print("Could not load the live Quran catalogue.");
        print(http.last_error());
        return 1;
    }

    let int total_surahs = surah_count(surahs);
    let int total_reciters = reciter_count(reciters);
    if (total_surahs != 114 or total_reciters <= 0) {
        print("The catalogue response is incomplete or has an unexpected shape.");
        return 1;
    }

    if (!tui.init()) {
        print(tui.last_error());
        return 1;
    }
    voice.init();
    let int current_surah = 1;
    let int current_reciter = 0;
    let int volume = 80;
    let bool playing = false;
    let bool paused = false;
    let bool running = true;
    let bool screen_dirty = true;
    let string message = "Ready. English reader directory loaded.";

    while (running) {
        if (playing and voice.is_finished()) {
            playing = false;
            paused = false;
            message = "Playback finished.";
            screen_dirty = true;
        }

        if (screen_dirty) {
            let owned_string current_surah_label = surah_name(current_surah - 1);
            let owned_string current_reciter_label = reciter_name(reciters, current_reciter);
            ui_draw_main(
                current_surah_label,
                current_reciter_label,
                current_surah, volume, playing, paused, message
            );
            screen_dirty = false;
        }

        let int key = tui.poll_key();
        if (key == 113 or key == 81) {
            running = false;
        } else if (key == 98 or key == 66) {
            let int previous_surah = current_surah;
            current_surah = choose_surah(surahs, current_surah);
            if (current_surah != previous_surah) {
                voice.stop();
                playing = false;
                paused = false;
            }
            message = "Surah selected.";
        } else if (key == 114 or key == 82) {
            let int previous_reciter = current_reciter;
            current_reciter = choose_reciter(reciters, current_reciter);
            if (current_reciter != previous_reciter) {
                voice.stop();
                playing = false;
                paused = false;
            }
            message = "Reader selected.";
        } else if (key == 47) {
            let owned_string query = ui_prompt("Search surah: ");
            let int found = find_surah(surahs, query);
            if (found > 0) {
                current_surah = found;
                voice.stop();
                playing = false;
                paused = false;
                message = "Search result selected.";
            } else {
                message = "No matching surah was found.";
            }
        } else if (key == 103 or key == 71) {
            let owned_string query = ui_prompt("Search reader: ");
            let int found = find_reciter(reciters, query);
            if (found >= 0) {
                current_reciter = found;
                voice.stop();
                playing = false;
                paused = false;
                message = "Reader search result selected.";
            } else {
                message = "No matching reader was found.";
            }
        } else if (key == 32) {
            if (paused) {
                voice.resume();
                paused = false;
                playing = true;
                message = "Resumed.";
            } else if (playing) {
                voice.pause();
                paused = true;
                message = "Paused.";
            } else if (start_current(reciters, current_surah, current_reciter, volume)) {
                playing = true;
                paused = false;
                message = "Playing online recitation.";
            } else {
                message = voice.last_error();
            }
        } else if (key == 110 or key == 78) {
            voice.stop();
            current_surah = current_surah + 1;
            if (current_surah > total_surahs) {
                current_surah = 1;
            }
            if (start_current(reciters, current_surah, current_reciter, volume)) {
                playing = true;
                paused = false;
                message = "Next surah.";
            } else {
                playing = false;
                message = voice.last_error();
            }
        } else if (key == 112 or key == 80) {
            voice.stop();
            current_surah = current_surah - 1;
            if (current_surah < 1) {
                current_surah = total_surahs;
            }
            if (start_current(reciters, current_surah, current_reciter, volume)) {
                playing = true;
                paused = false;
                message = "Previous surah.";
            } else {
                playing = false;
                message = voice.last_error();
            }
        } else if (key == 115 or key == 83) {
            voice.stop();
            playing = false;
            paused = false;
            message = "Stopped.";
        } else if (key == 102 or key == 70) {
            if (storage_add_favorite(current_surah)) {
                message = "Added to favorites.";
            }
            else {
                message = "Could not update favorites.";
            }
        } else if (key == 97 or key == 65) {
            let owned_string selected_reader = reciter_name(reciters, current_reciter);
            if (storage_add_playlist(current_surah, selected_reader)) {
                message = "Added to the default playlist.";
            }
            else {
                message = "Could not update playlist.";
            }
        } else if (key == 104 or key == 72) {
            show_saved("Listening history", "ytilawa-history.txt");
        } else if (key == 118 or key == 86) {
            show_saved("Favorites", "ytilawa-favorites.txt");
        } else if (key == 99 or key == 67) {
            show_saved("Default playlist", "ytilawa-playlist-default.txt");
        } else if (key == 100 or key == 68) {
            let int bytes = download_current(reciters, current_surah, current_reciter);
            if (bytes >= 0) {
                message = string.concat("Downloaded bytes: ", to_string(bytes));
            } else {
                message = "Download failed. Check the network and reader availability.";
            }
        } else if (key == 108 or key == 76) {
            let owned_string path = ui_prompt("Local MP3 path: ");
            if (player_play_local(path, volume)) {
                playing = true;
                paused = false;
                message = "Playing local file.";
            } else {
                message = voice.last_error();
            }
        } else if (key == 43 or key == 61) {
            volume = volume + 5;
            if (volume > 100) {
                volume = 100;
            }
            voice.set_volume(volume);
            message = "Volume increased.";
        } else if (key == 45) {
            volume = volume - 5;
            if (volume < 0) {
                volume = 0;
            }
            voice.set_volume(volume);
            message = "Volume decreased.";
        }

        if (key != -1) {
            screen_dirty = true;
        }
        tui.sleep_ms(20);
    }

    voice.stop();
    voice.shutdown();
    tui.show_cursor();
    tui.shutdown();
    return 0;
}
