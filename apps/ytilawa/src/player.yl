// Audio and download operations. This module owns HTTP-to-Voice handoff.

function player_play_remote(string url, int volume) -> bool {
    if (string.length(url) == 0) {
        return false;
    }
    let http_stream stream = http.stream_open("GET", url, "", "");
    if (!voice.set_volume(volume)) {
        http.stream_close(stream);
        return false;
    }
    // Ownership of stream moves to Voice from this point, including on failure.
    return voice.play_stream(stream);
}

function player_play_local(string path, int volume) -> bool {
    if (string.length(path) == 0) {
        return false;
    }
    if (!voice.set_volume(volume)) {
        return false;
    }
    return voice.play(path);
}

function player_download(string url, string path) -> int {
    if (string.length(url) == 0 or string.length(path) == 0) {
        return -1;
    }
    if (!io.write_file(path, "")) {
        return -1;
    }

    let http_stream stream = http.stream_open("GET", url, "", "");
    let int buffer = io.buffer_new(0);
    if (buffer < 0) {
        http.stream_close(stream);
        return -1;
    }

    let int total = 0;
    let bool okay = true;
    while (!http.stream_done(stream) and okay) {
        let int count = http.stream_read_buffer(stream, buffer, 65536);
        if (count < 0) {
            okay = false;
        } else if (count > 0) {
            let int written = io.buffer_append_file(path, buffer);
            if (written != count) {
                okay = false;
            } else {
                total = total + written;
            }
        }
    }

    let int status = http.stream_status(stream);
    let owned_string error = http.stream_error(stream);
    http.stream_close(stream);
    io.buffer_free(buffer);

    if (!okay or status != 200 or string.length(error) > 0) {
        return -1;
    }
    return total;
}

function player_pause() -> void {
    voice.pause();
}

function player_resume() -> void {
    voice.resume();
}

function player_stop() -> void {
    voice.stop();
}
