// Local text-file persistence for favorites, history, and playlists.

function storage_read(borrowed_string path) -> owned_string {
    if (!io.file_exists(path)) {
        return string.own("");
    }
    return io.read_file_owned(path);
}

function storage_append(borrowed_string path, borrowed_string record) -> bool {
    let owned_string existing = storage_read(path);
    if (string.length(existing) > 0 and !string.ends_with(existing, "\n")) {
        existing = owned_string.concat(existing, "\n");
    }
    let owned_string updated = owned_string.concat(existing, record);
    updated = owned_string.concat(updated, "\n");
    return io.write_file(path, updated);
}

function storage_contains(borrowed_string path, borrowed_string record) -> bool {
    let owned_string existing = storage_read(path);
    if (string.length(existing) == 0) {
        return false;
    }
    let owned_string marker = owned_string.concat("\n", record);
    marker = owned_string.concat(marker, "\n");
    let owned_string wrapped = owned_string.concat("\n", existing);
    return string.contains(wrapped, marker);
}

function storage_add_favorite(int surah_id) -> bool {
    let owned_string record = string.own(to_string(surah_id));
    if (storage_contains("ytilawa-favorites.txt", record)) {
        return true;
    }
    return storage_append("ytilawa-favorites.txt", record);
}

function storage_add_history(int surah_id, borrowed_string reciter) -> bool {
    let owned_string record = string.own(to_string(surah_id));
    record = owned_string.concat(record, "|");
    record = owned_string.concat(record, reciter);
    return storage_append("ytilawa-history.txt", record);
}

function storage_add_playlist(int surah_id, borrowed_string reciter) -> bool {
    let owned_string record = string.own(to_string(surah_id));
    record = owned_string.concat(record, "|");
    record = owned_string.concat(record, reciter);
    return storage_append("ytilawa-playlist-default.txt", record);
}
