// TUI presentation helpers. No network, storage, or audio state lives here.

function ui_draw_main(borrowed_string surah, borrowed_string reciter, int surah_id,
                      int volume, bool playing, bool paused, borrowed_string message) -> int {
    tui.write("\x1b[H\x1b[J");

    tui.write("\x1b[1;36m");
    tui.write("  YTILAWA EXTENDED\n");
    tui.write("\x1b[0;90m");
    tui.write("  MP3Quran.net  /  Quran audio library\n");
    tui.write("  ------------------------------------------------------------\n");
    tui.write("\x1b[0m");

    tui.write("\x1b[1;33m  NOW SELECTED\n");
    tui.write("\x1b[0m  Surah   ");
    tui.write("\x1b[1;37m");
    tui.write(surah);
    tui.write("\x1b[0;90m  #");
    tui.write(to_string(surah_id));
    tui.write("\x1b[K\x1b[0m\n  Reader  ");
    tui.write("\x1b[1;37m");
    tui.write(reciter);
    tui.write("\x1b[K\x1b[0m\n  Volume  ");
    tui.write("\x1b[1;35m");
    tui.write(to_string(volume));
    tui.write("%\x1b[K\x1b[0m\n  State   ");

    if (paused) {
        tui.write("\x1b[1;33mPAUSED\x1b[K\x1b[0m\n");
    }
    else if (playing) {
        tui.write("\x1b[1;32mPLAYING\x1b[K\x1b[0m\n");
    }
    else {
        tui.write("\x1b[0;90mSTOPPED\x1b[K\x1b[0m\n");
    }

    tui.write("\n\x1b[1;36m  CONTROLS\n");
    tui.write("\x1b[0;37m");
    tui.write("  B  Browse surahs       R  Browse readers\n");
    tui.write("  /  Search surah        G  Search reader\n");
    tui.write("  Space  Play / Pause\n");
    tui.write("  N  Next surah          P  Previous surah\n");
    tui.write("  S  Stop                F  Favorite\n");
    tui.write("  A  Add to playlist     C  Open playlist\n");
    tui.write("  D  Download            L  Local MP3\n");
    tui.write("  H  History             V  Favorites\n");
    tui.write("  + / -  Volume          Q / Ctrl+C  Quit\n");
    tui.write("\x1b[0m\n");

    tui.write("\x1b[0;90m  ------------------------------------------------------------\n");
    tui.write("\x1b[1;36m  ");
    tui.write(message);
    tui.write("\x1b[K\x1b[0m\n");
    tui.write("\x1b[J");
    tui.flush();
    return 0;
}

function ui_prompt(string prompt) -> owned_string {
    tui.shutdown();
    let owned_string value = terminal.read_line(prompt);
    if (!tui.init()) {
        print(tui.last_error());
    }
    return move(value);
}

function ui_wait(borrowed_string message) -> int {
    tui.write("\n");
    tui.write(message);
    tui.write(" — press any key");
    return tui.read_key();
}
