from "../apps/ytilawa/src/player.yl" import player_download;

function main() -> int {
    let string port = io.read_line();
    let string base = string.concat("http://127.0.0.1:", port);
    let string url = string.concat(base, "/stream-large");
    let int bytes = player_download(url, "build/ytilawa-stream-download.bin");
    print(bytes);
    print(io.binary_size("build/ytilawa-stream-download.bin"));
    return 0;
}
