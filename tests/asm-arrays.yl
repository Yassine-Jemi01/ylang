function main() -> int {
    let int values[] = [10, 20, 30];
    let string names[] = ["Ada", "Grace"];
    print(length(values), values[0], values[1], names[1]);
    values[1] = values[0] + 5;
    values[2] += 1;
    print(values[1], values[2]);
    let int index = 1;
    print(values[index]);
    return 0;
}
