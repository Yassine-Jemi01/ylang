enum OwnerChoice { First, Second }

function emit_choice(OwnerChoice choice) -> int {
    match (choice) {
        OwnerChoice.First -> {
            let owned_string first_value = string.own("first-arm");
            print(first_value);
        }
        OwnerChoice.Second -> {
            let owned_string second_value = string.own("second-arm");
            print(second_value);
        }
    }
    return 0;
}

function emit_branch(int selection) -> int {
    if (selection == 1) {
        let owned_string then_value = string.own("then-branch");
        print(then_value);
    } else {
        let owned_string else_value = string.own("else-branch");
        print(else_value);
    }
    return 0;
}

function main() -> int {
    emit_branch(1);
    emit_branch(0);
    emit_choice(OwnerChoice.First);
    emit_choice(OwnerChoice.Second);
    return 0;
}
