function add(int left, int right) -> int {
    return left + right;
}

function main() -> int {
    let int answer = add(20, 22);
    let int count = 0;

    let int negative = -7;
    print("Answer:", answer);
    print("Division:", negative / 2, negative % 2);
    while (count < 2) {
        print(count);
        count++;
    }

    if (answer == 42) {
        print("NASM backend works");
    } else {
        print("NASM backend failed");
        return 1;
    }
    return 0;
}
