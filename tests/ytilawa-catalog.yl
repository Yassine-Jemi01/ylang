from "../apps/ytilawa/src/catalog.yl" import reciter_audio_url, reciter_name, reciter_letter, surah_name;

function main() -> int {
    let owned_string document = json.parse("{\"reciters\":[{\"name\":\"Ibrahim Al-Akdar\",\"letter\":\"I\",\"moshaf\":[{\"server\":\"https://audio.example/\",\"surah_list\":\"1,2,10,114\"}]}]}");
    print(json.valid(document));
    print(reciter_name(document, 0));
    print(reciter_letter(document, 0));
    print(reciter_audio_url(document, 0, 1));
    print(reciter_audio_url(document, 0, 10));
    print(reciter_audio_url(document, 0, 114));
    print(string.length(reciter_audio_url(document, 0, 5)));
    print(surah_name(0));
    print(surah_name(1));
    print(surah_name(2));
    print(surah_name(113));
    return 0;
}
