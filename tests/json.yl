function main() -> int {
    let owned_string document = json.parse("{\"name\":\"YLang\",\"\\u03bb\":42,\"version\":23,\"price\":2.5,\"unicode\":\"\\uD83D\\uDE00\",\"enabled\":true,\"items\":[1,2,3],\"message\":\"hello\\nworld\"}");
    let owned_string items = json.get(document, "items");
    print(json.valid(document));
    print(json.get_string(document, "name"));
    print(json.get_int(document, "λ"));
    print(json.get_int(document, "version"));
    print(json.get_float(document, "price"));
    print(json.get_string(document, "unicode"));
    print(json.get_bool(document, "enabled"));
    print(json.has(document, "missing"));
    print(json.array_length(items));
    print(json.at(items, 1));
    let owned_string negative_index = json.at(items, -1);
    print(string.length(negative_index) == 0);
    print(string.contains(json.last_error(), "index out of range"));
    let owned_string high_index = json.at(items, 99);
    print(string.length(high_index) == 0);
    print(string.contains(json.last_error(), "index out of range"));
    print(json.get_string(document, "message"));
    print(json.stringify(document));
    print(json.escape("line\nquote\""));
    print(json.escape("café"));
    print(json.valid("{broken"));
    print(json.last_error());
    print(json.escape("recovered"));
    print(string.length(json.last_error()) == 0);
    let owned_string zero_doc = json.parse("{\"zero\":\"\\u0000\"}");
    print(json.get_string(zero_doc, "zero"));
    print(json.last_error());
    print(json.pretty("{\"text\":\"a, b: c\",\"n\":1}"));
    let owned_string obj = json.object();
    let owned_string title_json = json.escape("YLang");
    let owned_string obj2 = json.set(obj, "title", title_json);
    let owned_string obj3 = json.set(obj2, "count", "3");
    let owned_string arr = json.array();
    let owned_string arr2 = json.push(arr, "1");
    let owned_string arr3 = json.push(arr2, "true");
    print(obj3);
    print(json.get_string(obj3, "title"));
    print(json.get_int(obj3, "count"));
    let owned_string obj4 = json.set(obj3, "count", "4");
    print(obj4);
    print(obj3); // The prior value remains unchanged.
    print(arr3);
    print(arr2); // Appending creates a new array.
    print(json.array_length(arr3));
    print(json.remove(obj3, "count"));
    print(obj3); // Removing a property also leaves the original untouched.
    let owned_string duplicate_doc = json.parse("{\"count\":1,\"count\":2,\"other\":true}");
    print(json.get_int(duplicate_doc, "count"));
    print(json.set(duplicate_doc, "count", "9"));
    print(json.remove(duplicate_doc, "count"));
    print(json.set(obj3, "line\nkey", "false"));
    let owned_string invalid_fragment = json.set(obj3, "broken", "not-json");
    print(string.length(invalid_fragment) == 0);
    print(string.length(json.last_error()) > 0);
    let owned_string wrong_set_target = json.set("[]", "x", "1");
    print(string.length(wrong_set_target) == 0);
    print(string.contains(json.last_error(), "requires an object"));
    let owned_string wrong_remove_target = json.remove("[]", "x");
    print(string.length(wrong_remove_target) == 0);
    print(string.contains(json.last_error(), "requires an object"));
    let owned_string wrong_push_target = json.push("{}", "1");
    print(string.length(wrong_push_target) == 0);
    print(string.contains(json.last_error(), "requires an array"));
    let owned_string cleared_error_object = json.object();
    print(string.length(json.last_error()) == 0);
    let owned_string cleared_error_array = json.array();
    print(string.length(json.last_error()) == 0);
    let owned_string invalid_utf8 = to_string('\xFF');
    let owned_string invalid_utf8_escape = json.escape(invalid_utf8);
    print(string.length(invalid_utf8_escape) == 0);
    print(string.contains(json.last_error(), "not valid UTF-8"));
    let owned_string invalid_utf8_key = json.set(obj, invalid_utf8, "1");
    print(string.length(invalid_utf8_key) == 0);
    print(string.contains(json.last_error(), "not valid UTF-8"));
    return 0;
}
