function main() -> int {
    if (not gui.init()) { return 1; }
    if (not gui.create_window("GUI smoke test", 64, 64)) {
        gui.shutdown();
        return 2;
    }
    if (not gui.clear(10, 20, 30)) {
        gui.close();
        gui.shutdown();
        return 3;
    }
    if (not gui.draw_rect(1, 1, 20, 20, 200, 100, 50)) {
        gui.close();
        gui.shutdown();
        return 4;
    }
    let bool pressed = gui.key_pressed("Space");
    let bool released = gui.key_released("Space");
    let int image = gui.load_bmp("build/game2d-test.bmp");
    if (image < 0) {
        print(gui.last_error());
        gui.close();
        gui.shutdown();
        return 6;
    }
    if (not gui.draw_image(image, 40, 40)) {
        gui.close();
        gui.shutdown();
        return 7;
    }
    if (not gui.free_image(image)) {
        gui.close();
        gui.shutdown();
        return 8;
    }
    if (not gui.draw_text("TETRIS 123", 2, 28, 2, 240, 240, 240)) {
        gui.close();
        gui.shutdown();
        return 9;
    }
    if (not gui.present()) {
        gui.close();
        gui.shutdown();
        return 10;
    }
    gui.close();
    gui.shutdown();
    return 0;
}
