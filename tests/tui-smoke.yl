function main() -> int {
    if (not tui.init()) { return 1; }
    if (tui.width() < 1 or tui.height() < 1) {
        tui.shutdown();
        return 2;
    }
    tui.clear();
    if (not tui.set_color(39, 16)) { tui.shutdown(); return 3; }
    if (not tui.draw_box(1, 1, 24, 5, "smoke")) { tui.shutdown(); return 4; }
    if (not tui.progress_bar(2, 3, 20, 3, 4)) { tui.shutdown(); return 5; }
    if (not tui.fill_rect(2, 5, 8, 1, 46)) { tui.shutdown(); return 7; }
    tui.write_at(2, 4, "std.tui works");
    tui.move_to(2, 6);
    tui.clear_line();
    tui.println("ready");
    tui.reset_style();
    let int key = tui.read_key();
    if (key < -1) { tui.shutdown(); return 6; }
    if (tui.key_available()) {
        let int next_key = tui.read_key();
    }
    tui.sleep_ms(1);
    tui.shutdown();
    return 0;
}
