enum Choice { First, Second }

fn main() -> int {
    let Choice choice = Choice.First;
    let string source = string.concat("Y", "Lang");
    match (choice) {
        Choice.First -> {
            let string destination = move(source);
            print(destination);
        }
        Choice.Second -> {
            print(source);
        }
    }
    return 0;
}
