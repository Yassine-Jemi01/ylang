fn choose(int selection) -> void {
    let owned_string source = string.own("branch-owner");
    if (selection == 1) {
        let owned_string first = move(source);
        print(first);
    } else {
        let owned_string second = move(source);
        print(second);
    }
}

fn main() -> int {
    choose(1);
    choose(0);
    return 0;
}
