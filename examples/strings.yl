function main() -> int {
    let const string title = "YLang projects";
    print(string.length(title));
    print(string.contains(title, "projects"));
    print(string.starts_with(title, "YLang"));
    print(string.ends_with(title, "projects"));
    print(string.concat("Build ", "something."));
    print(string.upper("YLang strings"));
    print(string.lower("YLANG STRINGS"));
    print("apple" < "banana");
    print("apple" <= "apple");
    print("zebra" > "yak");
    print("banana" >= "apple");
    return 0;
}
