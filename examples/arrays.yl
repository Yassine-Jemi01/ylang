function main() -> int {
    let int[] scores = [10, 20, 30];
    scores[1] = 42;
    append(scores, 99);
    print(scores[1], len(scores));
    let int total = 0;
    for (int score in scores) {
        total = total + score;
    }
    print("Total:", total);
    let int[] backup = clone(scores);
    backup[0] = 7;
    print(scores[0], backup[0]);
    return 0;
}
