from game2d.yl import game2d_open, game2d_begin_frame, game2d_draw_rect, game2d_end_frame, game2d_close, game2d_last_error;

function main() -> int {
    if (not game2d_open("YLang 2D", 800, 500)) {
        print(game2d_last_error());
        return 1;
    }

    loop() {
        if (not game2d_begin_frame(24, 28, 38)) {
            break;
        }
        if (not game2d_draw_rect(80, 80, 240, 120, 22, 160, 180)) {
            print(game2d_last_error());
            break;
        }
        if (not game2d_end_frame()) {
            print(game2d_last_error());
            break;
        }
    }

    game2d_close();
    return 0;
}
