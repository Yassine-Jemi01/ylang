// Stream one user-supplied HTTPS audio URL without staging the full file locally.
// Build with: ylang build examples/voice-stream.yl -o voice-stream

function main() -> int {
    let owned_string url = terminal.read_line("HTTPS audio URL: ");
    if (string.length(url) == 0) {
        print("A URL is required.");
        return 1;
    }

    let http_stream stream = http.stream_open("GET", url, "", "");
    if (!voice.play_stream(stream)) {
        print(voice.last_error());
        voice.shutdown();
        return 1;
    }

    print("Streaming audio. Press Ctrl+C to stop.");
    while (!voice.is_finished()) {
        // The decoder thread pulls bounded chunks from the HTTP stream.
        tui.sleep_ms(20);
    }

    let string error = voice.last_error();
    if (error != "No error") {
        print(error);
    }
    voice.shutdown();
    return 0;
}
