function main() -> int {
    let int count = 9;
    let float precise = to_float(count);
    print(math.sqrt(precise));
    print(to_int(3.9));
    print(to_string(count));
    print(to_string(2.5));
    print(to_string(true));
    print(to_string('Z'));
    print(string.is_int("123"));
    print(string.is_int("12x"));
    print(string.parse_int("-42"));
    print(io.file_exists("README.md"));
    return 0;
}
