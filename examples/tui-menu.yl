// Responsive terminal menu demonstrating the std.tui primitives.
// Build with: ylang build examples/tui-menu.yl -o tui-menu

function main() -> int {
    if (!tui.init()) {
        print(tui.last_error());
        return 1;
    }

    let int selected = 0;
    let bool running = true;
    let int width = tui.width();

    tui.hide_cursor();
    while (running) {
        width = tui.width();
        tui.clear();

        tui.write("\\x1b[38;2;147;212;200mYLANG\\x1b[0m");
        tui.write("  /  WORKSPACE\n");
        tui.write("\\x1b[38;2;116;141;135mA small, native terminal interface\\x1b[0m\n");

        if (width >= 62) {
            tui.write("\\n\\x1b[38;2;215;154;115m+--------------------------------------------------+\\x1b[0m\n");
            tui.write("\\x1b[38;2;215;154;115m|\\x1b[0m  GET STARTED                                       \\x1b[38;2;215;154;115m|\\x1b[0m\n");
            tui.write("\\x1b[38;2;215;154;115m+--------------------------------------------------+\\x1b[0m\n");
        } else {
            tui.write("\\n\\x1b[38;2;215;154;115mGET STARTED\\x1b[0m\n");
            tui.write("\\x1b[38;2;116;141;135m------------------------------------\\x1b[0m\n");
        }

        if (selected == 0) tui.write("\\x1b[48;2;22;125;141m\\x1b[97m  >  New project\\x1b[0m\\n");
        else tui.write("\\x1b[38;2;200;220;213m     New project\\x1b[0m\\n");
        if (selected == 1) tui.write("\\x1b[48;2;22;125;141m\\x1b[97m  >  Open workspace\\x1b[0m\\n");
        else tui.write("\\x1b[38;2;200;220;213m     Open workspace\\x1b[0m\\n");
        if (selected == 2) tui.write("\\x1b[48;2;22;125;141m\\x1b[97m  >  Settings\\x1b[0m\\n");
        else tui.write("\\x1b[38;2;200;220;213m     Settings\\x1b[0m\\n");
        if (selected == 3) tui.write("\\x1b[48;2;22;125;141m\\x1b[97m  >  Quit\\x1b[0m\\n");
        else tui.write("\\x1b[38;2;200;220;213m     Quit\\x1b[0m\\n");

        if (width >= 62) {
            tui.write("\\x1b[38;2;215;154;115m+--------------------------------------------------+\\x1b[0m\\n");
        } else {
            tui.write("\\x1b[38;2;116;141;135m------------------------------------\\x1b[0m\\n");
        }

        if (width >= 44) {
            tui.write("\\n\\x1b[38;2;147;212;200mUP / DOWN\\x1b[0m  Navigate   ");
            tui.write("\\x1b[38;2;147;212;200mENTER\\x1b[0m  Select   ");
            tui.write("\\x1b[38;2;147;212;200mESC\\x1b[0m  Exit\\n");
        } else {
            tui.write("\\n\\x1b[38;2;147;212;200mUP/DOWN\\x1b[0m Move  ");
            tui.write("\\x1b[38;2;147;212;200mENTER\\x1b[0m Choose\\n");
            tui.write("\\x1b[38;2;147;212;200mESC\\x1b[0m Exit\\n");
        }

        let int key = tui.poll_key();
        if (key == -1) {
            // Repaint periodically so terminal resizes are noticed without input.
            tui.sleep_ms(80);
        } else if (key == 1001) {
            selected = selected - 1;
            if (selected < 0) selected = 3;
        } else if (key == 1002) {
            selected = selected + 1;
            if (selected > 3) selected = 0;
        } else if (key == 13) {
            running = false;
        } else if (key == 27) {
            selected = 3;
            running = false;
        }
    }

    tui.clear();
    tui.show_cursor();
    tui.write("\\x1b[38;2;147;212;200mYLANG\\x1b[0m  ");
    if (selected == 0) tui.write("New project selected.\\n");
    else if (selected == 1) tui.write("Open workspace selected.\\n");
    else if (selected == 2) tui.write("Settings selected.\\n");
    else tui.write("Goodbye.\\n");
    tui.shutdown();
    return 0;
}
