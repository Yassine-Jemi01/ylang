/*
 * YLang 2D helpers — experimental first milestone.
 * This module requires the optional SDL2 GUI runtime when linked.
 */

let int game2d_previous_tick = 0;

function game2d_open(string title, int width, int height) -> bool {
    if (not gui.init()) {
        return false;
    }
    if (not gui.create_window(title, width, height)) {
        gui.close();
        gui.shutdown();
        return false;
    }
    game2d_previous_tick = gui.ticks_ms();
    return true;
}

function game2d_begin_frame(int red, int green, int blue) -> bool {
    if (not gui.poll()) {
        return false;
    }
    return gui.clear(red, green, blue);
}

function game2d_draw_rect(int x, int y, int width, int height,
                          int red, int green, int blue) -> bool {
    return gui.draw_rect(x, y, width, height, red, green, blue);
}

function game2d_end_frame() -> bool {
    return gui.present();
}

function game2d_draw_text(string text, int x, int y, int scale,
                           int red, int green, int blue) -> bool {
    return gui.draw_text(text, x, y, scale, red, green, blue);
}

function game2d_load_bmp(string path) -> int {
    return gui.load_bmp(path);
}

function game2d_draw_image(int image, int x, int y) -> bool {
    return gui.draw_image(image, x, y);
}

function game2d_free_image(int image) -> bool {
    return gui.free_image(image);
}

function game2d_last_error() -> string {
    return gui.last_error();
}

function game2d_key_down(string key) -> bool {
    return gui.key_down(key);
}

function game2d_key_pressed(string key) -> bool {
    return gui.key_pressed(key);
}

function game2d_key_released(string key) -> bool {
    return gui.key_released(key);
}

function game2d_mouse_x() -> int {
    return gui.mouse_x();
}

function game2d_mouse_y() -> int {
    return gui.mouse_y();
}

function game2d_mouse_button_down(int button) -> bool {
    return gui.mouse_button_down(button);
}

function game2d_ticks_ms() -> int {
    return gui.ticks_ms();
}

function game2d_delta_ms() -> int {
    let int current_tick = gui.ticks_ms();
    let int delta = current_tick - game2d_previous_tick;
    game2d_previous_tick = current_tick;
    return delta;
}

function game2d_close() -> void {
    gui.close();
    gui.shutdown();
}

function game2d_rects_overlap(int ax, int ay, int aw, int ah,
                              int bx, int by, int bw, int bh) -> bool {
    if (aw <= 0 or ah <= 0 or bw <= 0 or bh <= 0) {
        return false;
    }
    return ax < bx + bw and ax + aw > bx and
           ay < by + bh and ay + ah > by;
}


/* Park-Miller PRNG. This is for game behavior, not cryptographic use. */
let int game2d_random_state = 1;

function game2d_random_seed(int seed) -> void {
    seed = seed % 2147483646;
    if (seed < 0) {
        seed = 0 - seed;
    }
    game2d_random_state = seed + 1;
}

function game2d_random() -> int {
    game2d_random_state = (game2d_random_state * 48271) % 2147483647;
    return game2d_random_state - 1;
}

function game2d_random_range(int minimum, int maximum) -> int {
    if (maximum < minimum) {
        return minimum;
    }
    if (minimum < -1073741823 or maximum > 1073741823) {
        return minimum;
    }
    let int span = maximum - minimum + 1;
    return minimum + (game2d_random() % span);
}

/* Small reusable helpers for frame-based animation and 2D motion. */
function game2d_animation_frame(int elapsed_ms, int frame_duration_ms,
                                int frame_count, bool looping) -> int {
    if (elapsed_ms < 0 or frame_duration_ms <= 0 or frame_count <= 0) {
        return 0;
    }
    let int frame = elapsed_ms / frame_duration_ms;
    if (looping) {
        return frame % frame_count;
    }
    if (frame >= frame_count) {
        return frame_count - 1;
    }
    return frame;
}

function game2d_clamp_float(float value, float minimum, float maximum) -> float {
    if (maximum < minimum) {
        return minimum;
    }
    if (value < minimum) {
        return minimum;
    }
    if (value > maximum) {
        return maximum;
    }
    return value;
}

function game2d_lerp(float start, float finish, float amount) -> float {
    return start + (finish - start) * amount;
}

function game2d_move_towards(float current, float target, float max_delta) -> float {
    if (max_delta <= 0.0) {
        return current;
    }
    if (target > current and target - current <= max_delta) {
        return target;
    }
    if (target < current and current - target <= max_delta) {
        return target;
    }
    if (target > current) {
        return current + max_delta;
    }
    if (target < current) {
        return current - max_delta;
    }
    return target;
}

function game2d_circles_overlap(float ax, float ay, float ar,
                                float bx, float by, float br) -> bool {
    if (ar < 0.0 or br < 0.0) {
        return false;
    }
    let float dx = ax - bx;
    let float dy = ay - by;
    let float radius = ar + br;
    return dx * dx + dy * dy <= radius * radius;
}

function game2d_point_in_rect(int px, int py, int rx, int ry,
                              int width, int height) -> bool {
    if (width <= 0 or height <= 0) {
        return false;
    }
    return px >= rx and py >= ry and
           px < rx + width and py < ry + height;
}
