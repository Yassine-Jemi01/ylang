{
  "name": "ylang-language-support",
  "displayName": "YLang Language Support",
  "description": "Syntax highlighting, file icon, and Code Runner support for YLang .yl files.",
  "version": "0.2.0",
  "publisher": "yassine-jemi01",
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ylang",
    "language",
    "syntax highlighting",
    "code runner",
    "compiler"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "ylang",
        "aliases": [
          "YLang",
          "ylang"
        ],
        "extensions": [
          ".yl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/ylang-light.svg",
          "dark": "./icons/ylang-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ylang",
        "scopeName": "source.ylang",
        "path": "./syntaxes/ylang.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[ylang]": {
        "code-runner.executorMapByFileExtension": {
          ".yl": "cd $dir && ylang build $fullFileName -o \"$fileNameWithoutExt\" && \"./$fileNameWithoutExt\""
        }
      }
    }
  }
}
