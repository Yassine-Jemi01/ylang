function main() -> int {
    let bool running = true;
    let int rounds = 0;
    while (running) {
        let int command = terminal.read_int("READY\n");
        if (command == 0) {
            running = false;
        } else {
            let int index = 0;
            while (index < __BATCH__) {
                let owned_string value = owned_string.concat("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");
                index++;
            }
            rounds++;
        }
    }
    print(rounds);
    return 0;
}
