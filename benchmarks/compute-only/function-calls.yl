function transform(int value) -> int {
    return (value * 31 + 7) % 1000003;
}

function benchmark() -> int {
    let int i = 0;
    let int value = 1;
    let int total = 0;
    while (i < 10000000) {
        value = transform(value + i);
        total = total + value;
        i = i + 1;
    }
    return total;
}
